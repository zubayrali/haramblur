{
	"name": "haramblur",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"protobufjs"
		]
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"check": "wxt prepare && biome check && tsc --noEmit && svelte-check --fail-on-warnings",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"bench": "tsx scripts/bench-engine.ts",
		"probe:webgpu": "tsx scripts/probe-webgpu.ts",
		"eval": "tsx scripts/eval.ts",
		"models:fetch": "tsx scripts/fetch-models.ts"
	},
	"dependencies": {
		"@webext-core/messaging": "^4.0.2",
		"onnxruntime-web": "~1.31.1",
		"xstate": "^5.33.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@playwright/test": "^1.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.0.0",
		"jsdom": "^31.0.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "~5.9.3",
		"vitest": "^5.1.1",
		"wxt": "^0.21.5"
	}
}
