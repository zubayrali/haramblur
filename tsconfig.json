{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		".wxt/**/*.ts",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"wxt.config.ts",
		"vitest.config.ts",
		"playwright.config.ts"
	]
}
